{
  "info": {
    "_postman_id": "8f5a2b1c-9e3d-4c7a-8b1e-5f9a0c2e4d6a",
    "name": "BNPL Microservice API Test Suite",
    "description": "Automated end-to-end and validation test suite for Buy Now Pay Later (BNPL) REST APIs, designed for Newman and Postman execution.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - E2E Chained Flow (Happy Path)",
      "item": [
        {
          "name": "1.1 - Register Eligible Customer (Age 35 -> $8,000 Limit)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains customer ID and $8,000 credit limit\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"id\");",
                  "    pm.expect(jsonData.creditLineAmount).to.eql(8000);",
                  "    pm.expect(jsonData.availableCreditLineAmount).to.eql(8000);",
                  "    pm.environment.set(\"customerId\", jsonData.id);",
                  "});",
                  "",
                  "pm.test(\"Header X-Auth-Token is present and stored\", function () {",
                  "    var token = pm.response.headers.get(\"X-Auth-Token\");",
                  "    pm.expect(token).to.not.be.empty;",
                  "    pm.environment.set(\"authToken\", token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Carlos\",\n  \"lastName\": \"Hernandez\",\n  \"secondLastName\": \"Lopez\",\n  \"dateOfBirth\": \"1989-05-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "customers"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.2 - Get Customer Credit Line & Balance",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Customer ID and credit balances match expected\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.eql(pm.environment.get(\"customerId\"));",
                  "    pm.expect(jsonData.creditLineAmount).to.eql(8000);",
                  "    pm.expect(jsonData.availableCreditLineAmount).to.eql(8000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "customers",
                "{{customerId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.3 - Create BNPL Loan ($1,000 Scheme 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Loan created with 13% commission and 5 installments\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"id\");",
                  "    pm.expect(jsonData.status).to.eql(\"ACTIVE\");",
                  "    pm.expect(jsonData.amount).to.eql(1000.00);",
                  "    pm.expect(jsonData.paymentPlan.commissionAmount).to.eql(130.00);",
                  "    pm.expect(jsonData.paymentPlan.installments).to.be.an(\"array\").that.has.lengthOf(5);",
                  "    pm.environment.set(\"loanId\", jsonData.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"amount\": 1000.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/loans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "loans"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.4 - Get Loan Schedule & Installments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Loan schedule has 5 installments summing total with interest ($1,130)\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.eql(pm.environment.get(\"loanId\"));",
                  "    pm.expect(jsonData.paymentPlan.installments.length).to.eql(5);",
                  "    var total = jsonData.paymentPlan.installments.reduce(function (acc, inst) {",
                  "        return acc + inst.amount;",
                  "    }, 0);",
                  "    pm.expect(Math.round(total * 100) / 100).to.eql(1130.00);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/loans/{{loanId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "loans",
                "{{loanId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "1.5 - Verify Deducted Available Credit Limit ($7,000 Remaining)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Available credit line deducted to 7000\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.creditLineAmount).to.eql(8000);",
                  "    pm.expect(jsonData.availableCreditLineAmount).to.eql(7000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "customers",
                "{{customerId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2 - Error & Edge Cases",
      "item": [
        {
          "name": "2.1 - Customer Ineligible by Age (< 18 years -> APZ000002)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Returns APZ000002 error code for invalid age\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(\"APZ000002\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Underage\",\n  \"lastName\": \"User\",\n  \"secondLastName\": \"Test\",\n  \"dateOfBirth\": \"2020-01-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "customers"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2.2 - Unauthorized Request (Missing Token -> APZ000007)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"Returns APZ000007 error code\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(\"APZ000007\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "customers",
                "{{customerId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2.3 - Customer Not Found (Unknown UUID -> APZ000005)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test(\"Returns APZ000005 error code\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(\"APZ000005\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/customers/00000000-0000-0000-0000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "customers",
                "00000000-0000-0000-0000-000000000000"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2.4 - Loan Exceeds Available Credit Limit (-> APZ000006)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Returns APZ000006 error code\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(\"APZ000006\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"amount\": 999999.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/loans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
